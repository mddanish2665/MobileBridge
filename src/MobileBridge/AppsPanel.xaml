<UserControl x:Class="MobileBridge.AppsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" AllowDrop="True" DragOver="Drop_DragOver" Drop="Drop_Drop"
                Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="2" CornerRadius="8" Padding="16,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Drag &amp; drop .apk / .xapk / .apks files here" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Button Content="Install APK…" Style="{StaticResource AccentButton}" Click="Install_Click"
                        HorizontalAlignment="Center" Margin="0"/>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,6">
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0"/>
            <StackPanel>
                <TextBlock Text="Installed apps" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Text="No device"/>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="FilterBox" TextChanged="Filter_TextChanged" Padding="4"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Open app" Click="Open_Click"/>
            <Button Content="Uninstall" Click="Uninstall_Click"/>
        </StackPanel>

        <ListBox x:Name="AppsList" MouseDoubleClick="AppsList_DoubleClick" FontFamily="Consolas" FontSize="13"/>
    </DockPanel>
</UserControl>
