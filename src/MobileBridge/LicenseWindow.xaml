<Window x:Class="MobileBridge.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License agreement" Height="580" Width="760" MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"
                   Text="MobileBridge downloads these components directly from Google's servers. To use them you must accept Google's license terms below."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Decline" IsCancel="True" Click="Decline_Click"/>
            <Button Content="I Accept" Style="{StaticResource AccentButton}" Click="Accept_Click" Margin="0,0,0,8"/>
        </StackPanel>
        <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
